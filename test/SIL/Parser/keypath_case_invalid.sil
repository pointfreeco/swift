//--- missing_extract.sil

sil_stage canonical

import Swift

enum E {
  case one(Int)
  case two
}

sil @embed : $@convention(keypath_accessor_getter) (@in_guaranteed Int) -> @out E

// CHECK: keypath enum_case component needs an enum element id, extract, and embed
sil @bad_id : $@convention(thin) () -> @owned CaseKeyPath<E, Int> {
bb0:
  %0 = keypath $CaseKeyPath<E, Int>, (root $E; enum_case $Optional<Int>, id #E.one!enumelt : (E.Type) -> (Int) -> E, embed @embed : $@convention(keypath_accessor_getter) (@in_guaranteed Int) -> @out E)
  return %0
}

//--- missing_embed.sil

sil_stage canonical

import Swift

enum E {
  case one(Int)
  case two
}

sil @extract : $@convention(keypath_accessor_getter) (@in_guaranteed E) -> @out Optional<Int>

// CHECK: keypath enum_case component needs an enum element id, extract, and embed
sil @bad_id : $@convention(thin) () -> @owned CaseKeyPath<E, Int> {
bb0:
  %0 = keypath $CaseKeyPath<E, Int>, (root $E; enum_case $Optional<Int>, id #E.one!enumelt : (E.Type) -> (Int) -> E, extract @extract : $@convention(keypath_accessor_getter) (@in_guaranteed E) -> @out Optional<Int>)
  return %0
}
